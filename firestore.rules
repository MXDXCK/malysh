rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Данные семьи доступны только тем, кто знает её код (XXXX-XXXX-XXXX-XXXX, 19 символов).
    // Список семей получить нельзя — правила для /families нет.
    match /families/{family}/items/{item} {
      allow read: if request.auth != null && family.size() == 19;

      // Запись — только в формате приложения: { v: текст или null, del: true/false, t: время сервера }.
      // Ограничения защищают бесплатный лимит от мусора: размер записи до 20 КБ, короткий id.
      allow create, update: if request.auth != null
        && family.size() == 19
        && item.size() <= 64
        && request.resource.data.keys().hasOnly(['v', 'del', 't'])
        && request.resource.data.t == request.time
        && (request.resource.data.v == null
            || (request.resource.data.v is string && request.resource.data.v.size() <= 20000))
        && (!('del' in request.resource.data.keys()) || request.resource.data.del is bool);

      // Полное удаление (так удаляли версии приложения до 1.5.0)
      allow delete: if request.auth != null && family.size() == 19;
    }
  }
}
